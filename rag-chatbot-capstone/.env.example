# Copy this to .env for local use (Render uses its own Environment tab)

# Free key from https://gnews.io -> sign up -> dashboard
# Without this, the app runs in "offline demo" mode (no real news).
GNEWS_API_KEY=

# Free key from https://console.groq.com -> API Keys
# Without this, the chatbot just shows raw matched headlines instead of
# a nicely written summary.
GROQ_API_KEY=
